# IDS Environment Example
# This file documents runtime environment variables used across modules.
# Copy these values into a real env file for local/dev/prod execution.

# Node environment (development|production|test)
NODE_ENV=development

# Player config source
IDS_CONFIG=shared/contract/examples/config.welcome.json
IDS_ADMIN_URL=http://127.0.0.1:8081

# Admin public URL (controls generated media URLs — must match the hostname clients use)
IDS_PUBLIC_ADMIN_URL=http://127.0.0.1:8081

# Admin persistent data directory
IDS_ADMIN_DATA_DIR=admin/data

# Optional detector config override (JSON string)
# IDS_DETECTOR_CONFIG={"movementPixelThreshold":28,"minPresenceRatio":0.03}

# Log level (debug|info|warn|error)
LOG_LEVEL=info

# Service ports
ADMIN_PORT=8081
PLAYER_PORT=7070
