# IDS runtime environment (Raspberry Pi)
# Recommended secure default:
# - keep admin and player bound to localhost on the Pi
# - access admin remotely via: ssh -L 8081:127.0.0.1:8081 <pi-user>@<pi-host>
# - render the player locally on the Pi display at http://127.0.0.1:7070
#
# If you intentionally expose IDS on the LAN later, change:
# ADMIN_HOST=0.0.0.0
# PLAYER_HOST=0.0.0.0
# IDS_PUBLIC_ADMIN_URL=http://<pi-hostname-or-ip>:8081

# Node environment
NODE_ENV=production

# Admin API key — REQUIRED in production. Generate with: openssl rand -hex 32
IDS_ADMIN_API_KEY=

# Public base URL used for generated admin media URLs.
IDS_PUBLIC_ADMIN_URL=http://127.0.0.1:8081

# Persistent admin state and uploads.
IDS_ADMIN_DATA_DIR=/var/lib/ids/admin

# Service ports
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8081
PLAYER_HOST=127.0.0.1
PLAYER_PORT=7070

# Player admin sync target
IDS_ADMIN_URL=http://127.0.0.1:8081

# Player startup config
IDS_CONFIG=/opt/ids/shared/contract/examples/config.welcome.json

# Optional detector overrides (JSON)
# IDS_DETECTOR_CONFIG={"movementPixelThreshold":28,"minPresenceRatio":0.03}

# NFC Reader
NFC_POLL_MS=800
NFC_COOLDOWN_MS=3000
