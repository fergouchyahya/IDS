# IDS runtime environment (Raspberry Pi)
# Public hostname used for generated admin media URLs.
IDS_PUBLIC_ADMIN_URL=http://raspberrypi.local:8081

# Persistent admin state and uploads.
IDS_ADMIN_DATA_DIR=/var/lib/ids/admin

# Service ports
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8081
PLAYER_HOST=0.0.0.0
PLAYER_PORT=7070

# Player admin sync target
IDS_ADMIN_URL=http://127.0.0.1:8081

# Player startup config
IDS_CONFIG=/opt/ids/shared/contract/examples/config.welcome.json

# Optional detector overrides (JSON)
# IDS_DETECTOR_CONFIG={"movementPixelThreshold":28,"minPresenceRatio":0.03}
